{
  "manifest_version": 3,
  "name": "Active Tab AI POC",
  "version": "0.1.14",
  "description": "Capture context from the active tab and ask an AI model.",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ask about this tab"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["tesseract/**"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "analyze-active-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Analyze the active browser tab"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
