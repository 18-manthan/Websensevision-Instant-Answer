{
  "manifest_version": 3,
  "name": "Active Tab AI POC",
  "version": "0.1.5",
  "description": "Capture context from the active tab and ask an AI model.",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ask about this tab"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "analyze-active-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Analyze the active browser tab"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
