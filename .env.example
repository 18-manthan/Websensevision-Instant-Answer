# Optional: leave empty to use the deterministic mock provider.
GROQ_API_KEY=

# Text captures use strict JSON Schema output on supported Groq models.
GROQ_TEXT_MODEL=openai/gpt-oss-20b

# Screenshot-only captures use a vision-capable model with JSON Object mode.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

GROQ_TIMEOUT_MS=45000
GROQ_MAX_RETRIES=2
API_BODY_LIMIT_BYTES=12582912
TESSERACT_LANG_PATH=.
PORT=8787
